# Copy to deploy/.env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me-long-random
# python -m tt.cli gen-master-key   (back this up offline: losing it loses all 2FA seeds and API keys)
TT_MASTER_KEY=
# true in production (HTTPS via Tailscale); false only for local http testing
TT_COOKIE_SECURE=true
